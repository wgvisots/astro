#pragma once

/// \file
/// The version of the astro library, from the `project(... VERSION ...)` line of CMakeLists.txt.
/// This header is generated by CMake (from include/astro/version.h.in) into the build directory and
/// installed with the other headers.
///
/// The library follows semantic versioning: the major number changes for a change that breaks
/// existing code (before 1.0, the minor number does), the minor number for new features, and the
/// patch number for fixes. CHANGELOG.md lists the changes of each release.

/// Major version.
#define ASTRO_VERSION_MAJOR @PROJECT_VERSION_MAJOR@
/// Minor version.
#define ASTRO_VERSION_MINOR @PROJECT_VERSION_MINOR@
/// Patch version.
#define ASTRO_VERSION_PATCH @PROJECT_VERSION_PATCH@
/// The version as text, "MAJOR.MINOR.PATCH".
#define ASTRO_VERSION_STRING "@PROJECT_VERSION@"
/// The version as one number, MAJOR * 10000 + MINOR * 100 + PATCH, for comparisons in the
/// preprocessor: `#if ASTRO_VERSION >= 200` means 0.2.0 or later.
#define ASTRO_VERSION (ASTRO_VERSION_MAJOR * 10000 + ASTRO_VERSION_MINOR * 100 + ASTRO_VERSION_PATCH)

namespace astro {

/// The version of the library as text, "MAJOR.MINOR.PATCH" (the same as ASTRO_VERSION_STRING).
inline constexpr const char* versionString = ASTRO_VERSION_STRING;

} // namespace astro
